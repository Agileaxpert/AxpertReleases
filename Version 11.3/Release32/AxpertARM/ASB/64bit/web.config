<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <fileExtensions>
          <remove fileExtension=".xml" />
          <add fileExtension=".xml" allowed="false" />
          <remove fileExtension=".txt" />
          <add fileExtension=".txt" allowed="false" />
          <remove fileExtension=".json" />
          <add fileExtension=".json" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <!--<add name="X-Frame-Options" value="SAMEORIGIN" />-->
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <rule name="AllowXmlTxtJsonInAxpert" stopProcessing="true">
          <match url="^axpert/.*\.(xml|txt|json)$" />
          <action type="None" />
        </rule>
        <rule name="BlockXmlTxtJsonOutsideAxpert" stopProcessing="true">
          <match url=".*\.(xml|txt|json)$" />
          <action type="AbortRequest" />
        </rule>
      </rules>
    </rewrite>
    <handlers accessPolicy="Read, Execute, Script" />
    <staticContent>
      <mimeMap fileExtension=".msg" mimeType="application/vnd.ms-outlook" />
      <mimeMap fileExtension=".dxf" mimeType="application/dxf" />
      <mimeMap fileExtension=".ifc" mimeType="application/x-step" />
    </staticContent>
  </system.webServer>
  <location path="axpert">
    <system.webServer>
      <security>
        <requestFiltering>
          <fileExtensions>
            <remove fileExtension=".xml" />
            <add fileExtension=".xml" allowed="true" />
            <remove fileExtension=".txt" />
            <add fileExtension=".txt" allowed="true" />
            <remove fileExtension=".json" />
            <add fileExtension=".json" allowed="true" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
